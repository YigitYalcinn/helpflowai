{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "experimentalServices": {
    "frontend": {
      "entrypoint": "frontend",
      "routePrefix": "/",
      "framework": "vite"
    },
    "backend": {
      "entrypoint": "backend/api/index.ts",
      "routePrefix": "/api",
      "framework": "express",
      "includeFiles": [
        "backend/prisma/**",
        "backend/src/**",
        "backend/package.json"
      ]
    }
  }
}
